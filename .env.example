# Copy to .env and edit. Never commit the real .env file.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=*
# Needed when you serve over HTTPS or a domain, e.g. https://lms.example.com
CSRF_TRUSTED_ORIGINS=

# ---- Database (leave DB_HOST empty to use local SQLite) ----
DB_HOST=
DB_NAME=learnhub
DB_USER=postgres
DB_PASSWORD=
DB_PORT=5432

# ---- File storage (False = local /media folder) ----
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
# Leave the two keys empty on AWS. The IAM role is used automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- First run (used by deploy/ec2/setup.sh and Beanstalk) ----
# Creates an admin login automatically. Remove the password again after first deploy.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# True loads demo users, three courses, quizzes and assignments (uploads sample files to S3).
SEED_DEMO=False
